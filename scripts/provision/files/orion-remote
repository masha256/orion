def log_call(env, verb, argc, result):
    try:
        fd = os.open(env.path('remote.log'), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, 'a') as f:
            f.write(f'{iso_seconds()} {env.user} {verb} {argc} {result}\n')
    except OSError:
        pass


def main():
    os.umask(0o077)
    env = Env()
    if env.name is None:
        print(f'orion-remote: {env.user!r} is not an Orion user (orion-prod or orion-stage)', file=sys.stderr)
        return EX_USAGE
    raw = os.environ.get('SSH_ORIGINAL_COMMAND', '')
    verb, argc = '-', 0
    try:
        argv = split_command(raw)
        argc = len(argv)
        if argv[0] not in VERBS:
            verb = '?'
            shown = argv[0] if len(argv[0]) <= 40 and argv[0].isprintable() else argv[0][:40].encode('unicode_escape').decode()
            raise Refused(f"'{shown}' is not an allowed verb")
        verb = argv[0]
        rc = VERBS[verb](env, argv[1:])
    except Refused as err:
        print(f'orion-remote: {err}', file=sys.stderr)
        log_call(env, verb, argc, 'refused')
        return EX_USAGE
    except Failed as err:
        print(f'orion-remote: {err}', file=sys.stderr)
        log_call(env, verb, argc, 'exit 1')
        return 1
    except Exception as err:  # a bug or a missing tool: one line, logged, never a traceback with caller text
        print(f'orion-remote: internal error: {type(err).__name__}: {str(err)[:300]}', file=sys.stderr)
        log_call(env, verb, argc, 'exit 1')
        return 1
    log_call(env, verb, argc, 'ok' if rc == 0 else f'exit {rc}')
    return rc


if __name__ == '__main__':
    sys.exit(main())
