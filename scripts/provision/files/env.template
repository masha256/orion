# Orion @ENV@ secrets: ~orion-@ENV@/shared/.env, mode 600, owner orion-@ENV@ (spec §4).
# Created once by scripts/provision/orion-host.sh and never overwritten or read by it. Fill in what this environment
# needs (uncomment the line); Orion reads this file itself at the start of every job, so nothing has to be restarted.
# Never copy this file into a release, a tarball, a log or deploys.log. ORION_HOME is not set here (the unit sets it).

# Postgres over the local socket, peer auth, no password.
#ORION_DATABASE_URL=postgresql:///@DB@?host=/var/run/postgresql

# Ethereum mainnet RPC URL (prod: the prod Alchemy app; staging: its own Alchemy app with its own key).
#ORION_ETH_RPC_URL=
# Base RPC URL (same Alchemy app as ORION_ETH_RPC_URL for this environment).
#ORION_BASE_RPC_URL=
# BNB Chain RPC URL.
#ORION_BNB_RPC_URL=
# Solana RPC URL.
#ORION_SOL_RPC_URL=

# CoinGecko API key (prod: the Basic plan key; staging: a free Demo key).
#COINGECKO_API_KEY=

# Anthropic API key, for disclosure runs only (prod); leave unset on staging (its watcher runs --dry-run).
#ANTHROPIC_API_KEY=

# Slack incoming webhook (prod: #orion-ops; staging: #orion-staging).
#SLACK_WEBHOOK_URL=

# Snapshot publisher (spec §9.2). prod: git:git@github.com:masha256/orion-data.git#main
# staging: git:git@github.com:masha256/orion-data-staging.git#main
#ORION_PUBLISH=

# S3-compatible publisher driver: unset until a bucket is chosen (exact names fixed when the driver is built, 1.5c+).
# Endpoint URL of the S3-compatible service.
#ORION_PUBLISH_S3_ENDPOINT=
# Bucket name.
#ORION_PUBLISH_S3_BUCKET=
# Key prefix inside the bucket.
#ORION_PUBLISH_S3_PREFIX=
# Access key id.
#ORION_PUBLISH_S3_ACCESS_KEY_ID=
# Secret access key.
#ORION_PUBLISH_S3_SECRET_ACCESS_KEY=

# Dead-man's-switch ping URL for this environment's check (spec §5.6).
#ORION_DEADMAN_URL=
